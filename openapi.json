  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Item": {
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "Item"
      },
      "Product": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Name"
          },
          "stock": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Stock"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "stock"
        ],
        "title": "Product"
      },
      "Reserve": {
        "properties": {
          "reservation_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Reservation Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reservation_id",
          "items"
        ],
        "title": "Reserve"
      },
      "Stock": {
        "properties": {
          "delta": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "Delta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "delta"
        ],
        "title": "Stock"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
